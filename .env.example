# Supabase Environment Configuration
# Replace these values with your actual project credentials from your Supabase Dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: enable known mock users only for local Vite development.
# VITE_ENABLE_MOCK_AUTH=false

# Supabase Edge Function secret (configure with `supabase secrets set`, not in Vite).
# PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
